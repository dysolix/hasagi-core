{
  "name": "@hasagi/core",
  "private": true,
  "version": "0.10.0",
  "description": "A library that makes using the League of Legends client API (LCU) easy.",
  "author": "dysolix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dysolix/hasagi-core.git"
  },
  "bugs": {
    "url": "https://github.com/dysolix/hasagi-core/issues"
  },
  "homepage": "https://github.com/dysolix/hasagi-core#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.0.0"
  },
  "scripts": {
    "build": "node scripts/prebuild.mjs && tsc && node scripts/postbuild.mjs",
    "check:src": "npm run lint && npm run check:types && npm run test:unit",
    "check:package": "npm run build && publint ./dist && attw --pack ./dist",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "npm run test:typecheck && vitest run",
    "test:unit": "npm run test:typecheck && vitest run tests/unit",
    "test:integration": "npm run test:typecheck && vitest run tests/integration",
    "test:typecheck": "tsc -p tests/tsconfig.json",
    "release": "npm run check:src && npm run build && publint ./dist && attw --pack ./dist && npm publish ./dist --access public",
    "changelog": "node scripts/changelog-stub.mjs",
    "postversion": "npm run changelog",
    "version:patch": "npm version patch --ignore-scripts=false",
    "version:minor": "npm version minor --ignore-scripts=false",
    "version:major": "npm version major --ignore-scripts=false"
  },
  "keywords": [
    "hasagi",
    "league-of-legends",
    "league",
    "lol",
    "lcu",
    "lcu-api",
    "league-client",
    "typescript"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.5.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./credentials": {
      "types": "./credentials.d.ts",
      "default": "./credentials.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "./types.d.ts"
      ],
      "credentials": [
        "./credentials.d.ts"
      ]
    }
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  }
}
